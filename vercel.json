{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/**,public/service.html,public/product.html}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/services/:id",
      "destination": "/api/index"
    },
    {
      "source": "/shop/:id",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/api/index"
    },
    {
      "source": "/guide",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|woff2|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/service",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.+)"
        }
      ],
      "destination": "/services/:id",
      "permanent": true
    },
    {
      "source": "/service.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.+)"
        }
      ],
      "destination": "/services/:id",
      "permanent": true
    },
    {
      "source": "/product",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.+)"
        }
      ],
      "destination": "/shop/:id",
      "permanent": true
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.+)"
        }
      ],
      "destination": "/shop/:id",
      "permanent": true
    }
  ]
}
